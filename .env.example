# Configuration for AI Excel Automation

# LM Studio / Local LLM Settings
# Base URL for OpenAI-compatible API (e.g., LM Studio)
LLM_BASE_URL=http://localhost:1234/v1
# Model name to use (depends on what's loaded in LM Studio)
LLM_MODEL=local-model
# Temperature for response generation
LLM_TEMPERATURE=0.1
# Max tokens for response
LLM_MAX_TOKENS=2000

# Excel Settings
DEFAULT_EXCEL_FILE=Automation.xlsm
